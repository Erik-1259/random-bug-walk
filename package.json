{
  "name": "random-bug-walk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.21 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck && uv run --locked --all-packages pyright",
    "lint": "eslint . --max-warnings 0 && uv run --locked ruff check && uv run --locked ruff format --check",
    "test": "vitest run --passWithNoTests && (uv run --locked --all-packages pytest || [ $? -eq 5 ])"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
