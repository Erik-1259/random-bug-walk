#!/bin/sh
# In-image self-test of the runtime image's contents. Run it as root in a fresh container, before a
# source tree is placed:
#
#   docker run --rm --network none <tag> /opt/rbw/bin/rbw-runtime-selftest
#
# It checks that the image holds no app source, no fixture and no list of the app's file hashes;
# that Umami's locked dependencies, the verifier, the driver and the migrated database are there;
# and that the driver runs: it freezes the original suite and prints the frozen manifest's SHA-256
# and the kit manifest's SHA-256, for comparison with the adapter's pins.
#
# Each check prints "pass <name>" or "fail <name>" (with its output indented below a failure).
# The exit status is 1 if any check failed. It starts and stops Postgres.
# shellcheck disable=SC2329 # the check functions and cleanup run indirectly, through check and trap
set -u
APP=/workspace/app
VERIFIER=/opt/rbw/verifier
NODE=$VERIFIER/node/bin/node
DRIVER=$VERIFIER/kit/umami-driver/src/cli.ts
failures=0

[ "$(id -u)" = 0 ] || { echo "rbw-runtime-selftest: must run as root" >&2; exit 2; }
scratch=$(mktemp -d /run/rbw-selftest.XXXXXX)

cleanup() {
  /opt/rbw/bin/rbw-stop > /dev/null 2>&1
  rm -r -f "$scratch"
}
trap cleanup EXIT

# check <name> <command...>: the check passes when the command succeeds.
check() {
  name=$1
  shift
  if "$@" > "$scratch/check.log" 2>&1; then
    echo "pass $name"
  else
    echo "fail $name"
    sed 's/^/    /' "$scratch/check.log" | head -n 40
    failures=$((failures + 1))
  fi
}

# Every path under the app directory except the locked dependencies; the arguments are find's tests.
outside_dependencies() {
  find "$APP" \( -path "$APP/node_modules" -o -path "$APP/packages/*/node_modules" \) -prune -o "$@" -print
}

no_app_source_files() {
  found=$(outside_dependencies ! -type d | head -n 20)
  echo "$found"
  [ -z "$found" ]
}

# Only the directories that lead to a node_modules directory are left of the app tree.
no_app_source_directories() {
  found=$(outside_dependencies -type d | grep -v -x -e "$APP" -e "$APP/packages" -e "$APP/packages/[^/]*" | head -n 20)
  echo "$found"
  [ -z "$found" ] || return 1
  for dir in "$APP"/packages/*; do
    [ -d "$dir/node_modules" ] || { echo "$dir holds no node_modules"; return 1; }
  done
}

no_fixture() {
  found=$(find / -xdev \( -name 'umami-fixture*' -o -name '*.check.ts' \) -print 2>/dev/null | head -n 20)
  echo "$found"
  [ -z "$found" ] && [ ! -e "$VERIFIER/kit/umami-fixture" ]
}

no_app_file_hash_list() {
  [ ! -e "$VERIFIER/app-tracked.sha256" ]
}

locked_dependencies_present() {
  for path in "$APP/node_modules/.modules.yaml" "$APP/node_modules/.bin/next" "$APP/node_modules/.bin/prisma" \
    "$APP/packages/api-client/node_modules" "$APP/packages/mcp/node_modules"; do
    [ -e "$path" ] || { echo "missing $path"; return 1; }
  done
}

verifier_parts_present() {
  for path in "$NODE" "$DRIVER" "$VERIFIER/node_modules/@playwright/test/package.json" "$VERIFIER/suite/playwright.api.config.ts" \
    "$VERIFIER/closure.sha256" "$VERIFIER/image-manifest.json" "$VERIFIER/kit/schema/package.json" "$VERIFIER/kit/node_modules/@rbw/schema"; do
    [ -e "$path" ] || { echo "missing $path"; return 1; }
  done
}

suite_closure_hashes_match() {
  (cd "$VERIFIER/suite" && sha256sum -c "$VERIFIER/closure.sha256" > /dev/null) || return 1
  (cd "$VERIFIER/suite" && find . -type f | sed 's|^\./||' | LC_ALL=C sort) > "$scratch/suite-files"
  awk '{ print $2 }' "$VERIFIER/closure.sha256" | diff - "$scratch/suite-files"
}

verifier_tree_is_root_only() {
  wrong=$(find "$VERIFIER" ! -user root -o ! -group root -o \( -type d ! -perm 0700 \) \
    -o \( -type f ! -perm 0600 ! -perm 0700 \))
  echo "$wrong" | head -n 20
  [ -z "$wrong" ]
}

no_setuid_or_setgid_files() {
  found=$(find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -print 2>/dev/null)
  echo "$found"
  [ -z "$found" ]
}

runtimes_are_pinned() {
  verifier_node=$("$NODE" --version)
  app_node=$(/opt/rbw/bin/rbw-launch --as app -- node --version)
  pnpm_version=$(/opt/rbw/bin/rbw-launch --as app -- pnpm --version)
  echo "verifier node $verifier_node, app node $app_node, pnpm $pnpm_version"
  case $verifier_node in v24.*) ;; *) return 1 ;; esac
  [ "$app_node" = "v$NODE_VERSION" ] && [ "$pnpm_version" = 12.3.4 ]
}

database_is_migrated() {
  /opt/rbw/bin/rbw-start --db-only || return 1
  applied=$(psql -X -tA -h /run/rbw-pg -U postgres -d umami \
    -c 'SELECT count(*) FILTER (WHERE finished_at IS NOT NULL AND rolled_back_at IS NULL), count(*) FROM _prisma_migrations')
  /opt/rbw/bin/rbw-stop || return 1
  echo "applied|recorded migrations: $applied"
  case $applied in 0\|* | *\|0) return 1 ;; esac
  [ "${applied%|*}" = "${applied#*|}" ]
}

prepare_refuses_an_empty_app_directory() {
  ! /opt/rbw/bin/rbw-prepare-app || return 1
  no_app_source_files
}

# The driver prints the frozen manifest's original_suite_sha256, its test count and its spec files.
driver_freezes_the_original_suite() {
  "$NODE" "$DRIVER" freeze --out "$scratch/original-suite.json"
}

check no-app-source-files no_app_source_files
check no-app-source-directories no_app_source_directories
check no-fixture no_fixture
check no-app-file-hash-list no_app_file_hash_list
check locked-dependencies-present locked_dependencies_present
check verifier-parts-present verifier_parts_present
check suite-closure-hashes-match suite_closure_hashes_match
check verifier-tree-is-root-only verifier_tree_is_root_only
check no-setuid-or-setgid-files no_setuid_or_setgid_files
check runtimes-are-pinned runtimes_are_pinned
check database-is-migrated database_is_migrated
check prepare-refuses-an-empty-app-directory prepare_refuses_an_empty_app_directory
check driver-freezes-the-original-suite driver_freezes_the_original_suite
grep '^original_suite_sha256=' "$scratch/check.log"
echo "kit_manifest_sha256=$(sha256sum "$VERIFIER/image-manifest.json" | cut -d ' ' -f 1)"

if [ "$failures" -eq 0 ]; then
  echo "selftest: all checks passed"
  exit 0
fi
echo "selftest: $failures check(s) failed"
exit 1
