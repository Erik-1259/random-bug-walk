#!/bin/sh
# Toxiproxy in front of Postgres, for the race kit image. Run as root.
#
#   rbw-proxy start              starts toxiproxy-server as rbw-db with its API on 127.0.0.1:8474,
#                                creates the "postgres" proxy (127.0.0.1:5433 -> 127.0.0.1:5432),
#                                sets the latency toxic, marks Toxiproxy's log and runs "check"
#   rbw-proxy check              exits 0 only when the running proxy and its toxic are exactly as
#                                configured AND Toxiproxy logged no API request other than a GET
#                                since the last start or set-latency, so a change that was put
#                                back before the check still fails it
#   rbw-proxy set-latency <ms>   sets this container's latency (0 to 10000 ms) in place of the
#                                image default, until "set-latency default"; applies it at once
#                                when the proxy runs, then runs "check"
#   rbw-proxy latency            prints the latency in effect and whether it is the image default
#   rbw-proxy stop               stops toxiproxy-server's launcher and waits for it
#
# The API has no authentication, and every local user can reach it on loopback, rbw-app included.
# Toxiproxy logs every API request to a root-only log, which "check" audits; see README.md.
# The parsing and comparison are in /opt/rbw/verifier/rbw-proxy-check.ts (src/proxy-check.ts).
set -u
LAUNCH=/opt/rbw/bin/rbw-launch
NODE=/opt/rbw/verifier/node/bin/node
HELPER=/opt/rbw/verifier/rbw-proxy-check.ts
CONFIG=/opt/rbw/etc/race.environment
LOGS=/var/lib/rbw/logs
# Toxiproxy's own log, one JSON line per event and per API request. toxiproxy-server appends to it
# itself, as rbw-db in a directory only rbw-db and root can enter: rbw-launch's capture buffers
# its output, so a request could stay unlogged there for as long as the API is quiet.
API_LOG_DIR=/var/lib/rbw/toxiproxy
LOG=$API_LOG_DIR/api.log
RUN=/run/rbw
OVERRIDE=$RUN/race-latency.environment
MARK=$RUN/toxiproxy.log-mark
LOG_BYTES=16777216
API_HOST=127.0.0.1
API_PORT=8474
API=http://$API_HOST:$API_PORT
PROXY=postgres
LISTEN=127.0.0.1:5433
UPSTREAM=127.0.0.1:5432
TOXIC=latency_downstream

fail() {
  echo "rbw-proxy: $1" >&2
  exit 1
}

running() {
  [ -f "$RUN/toxiproxy.pid" ] && kill -0 "$(cat "$RUN/toxiproxy.pid")" 2>/dev/null
}

# api <user agent> <curl arguments>: the agent lets the audit find rbw-proxy's own requests.
api() {
  agent=$1
  shift
  curl -fsS --max-time 5 -A "$agent" -H 'Content-Type: application/json' "$@"
}

# The verifier's Node runs the helper; the image has no jq.
helper() {
  env -i "$NODE" "$HELPER" "$@"
}

# The latency in effect: this container's override when root set one, else the image default.
latency_ms() {
  helper latency "$CONFIG" "$OVERRIDE"
}

log_size() {
  if [ -f "$LOG" ]; then wc -c < "$LOG" | tr -d ' '; else echo 0; fi
}

# Runs a helper command again, for up to 5 s, while it exits 3 (its request is not logged yet).
retry() {
  retry_tries=0
  while :; do
    "$@"
    retry_status=$?
    [ "$retry_status" -eq 3 ] || return "$retry_status"
    retry_tries=$((retry_tries + 1))
    [ "$retry_tries" -le 50 ] || { echo "rbw-proxy: Toxiproxy did not log the request within 5 s" >&2; return 1; }
    sleep 0.1
  done
}

# Replaces the toxic with one at the given latency, then marks the log just after these writes,
# so "check" audits only the requests that came later.
apply_toxic() {
  from=$(log_size)
  api rbw-proxy -o /dev/null -X DELETE "$API/proxies/$PROXY/toxics/$TOXIC" 2>/dev/null
  api rbw-proxy -o /dev/null -X POST "$API/proxies/$PROXY/toxics" \
    -d "{\"name\":\"$TOXIC\",\"type\":\"latency\",\"stream\":\"downstream\",\"toxicity\":1,\"attributes\":{\"latency\":$1,\"jitter\":0}}" ||
    { echo "rbw-proxy: could not set the latency toxic" >&2; return 1; }
  api rbw-proxy-mark -o /dev/null "$API/version" || return 1
  mark=$(retry helper mark "$LOG" "$from") || { echo "rbw-proxy: could not mark the Toxiproxy log" >&2; return 1; }
  ( umask 077 && echo "$mark" > "$MARK" )
}

check() {
  latency=$(latency_ms) || return 1
  [ -f "$MARK" ] || { echo "rbw-proxy: no log mark; run rbw-proxy start" >&2; return 1; }
  ok=0
  proxies=$(api rbw-proxy-check "$API/proxies") || { echo "rbw-proxy: the Toxiproxy API does not answer" >&2; return 1; }
  printf '%s' "$proxies" | helper check "$PROXY" "$LISTEN" "$UPSTREAM" "$TOXIC" "$latency" || ok=1
  retry helper audit "$LOG" "$(cat "$MARK")" "$LOG_BYTES" || ok=1
  [ "$ok" -eq 0 ] || return 1
  echo "proxy_checked latency_ms=$latency"
}

show_latency() {
  latency=$(latency_ms) || exit 1
  source=default
  [ -f "$OVERRIDE" ] && source=override
  echo "proxy_latency latency_ms=$latency source=$source"
}

set_latency() {
  value=$1
  if [ "$value" = default ]; then
    rm -f "$OVERRIDE"
  else
    helper valid-latency "$value" || exit 1
    install -d -o root -g root -m 0700 "$RUN"
    ( umask 077 && printf 'RBW_RACE_LATENCY_MS=%s\n' "$value" > "$OVERRIDE.tmp" && mv "$OVERRIDE.tmp" "$OVERRIDE" ) ||
      fail "could not write $OVERRIDE"
  fi
  latency=$(latency_ms) || exit 1
  if running; then
    apply_toxic "$latency" || exit 1
    check > /dev/null || fail "the proxy does not match its configuration"
  fi
  show_latency
}

start() {
  latency=$(latency_ms) || exit 1
  install -d -o root -g root -m 0700 "$RUN" "$LOGS"
  install -d -o rbw-db -g rbw-db -m 0700 "$API_LOG_DIR"
  if ! running; then
    # shellcheck disable=SC2016 # expanded by the launched shell
    "$LAUNCH" --as db --max-stream-bytes "$LOG_BYTES" \
      --stdout "$LOGS/toxiproxy.stdout.log" --stderr "$LOGS/toxiproxy.stderr.log" -- \
      /bin/sh -c 'umask 077 && exec "$0" -host "$1" -port "$2" -seed 1 >> "$3"' \
      /usr/local/bin/toxiproxy-server "$API_HOST" "$API_PORT" "$LOG" \
      < /dev/null > /dev/null 2>> "$LOGS/toxiproxy.launcher.log" &
    echo $! > "$RUN/toxiproxy.pid"
  fi
  tries=0
  until api rbw-proxy -o /dev/null "$API/version" 2>/dev/null; do
    tries=$((tries + 1))
    running || fail "toxiproxy-server exited before its API answered"
    [ "$tries" -le 100 ] || fail "the Toxiproxy API did not answer within 10 s"
    sleep 0.1
  done
  if ! api rbw-proxy -o /dev/null "$API/proxies/$PROXY" 2>/dev/null; then
    api rbw-proxy -o /dev/null -X POST "$API/proxies" \
      -d "{\"name\":\"$PROXY\",\"listen\":\"$LISTEN\",\"upstream\":\"$UPSTREAM\",\"enabled\":true}" ||
      fail "could not create the $PROXY proxy"
  fi
  # Replaces the toxic, so a restart always applies the latency in effect.
  apply_toxic "$latency" || exit 1
  check > /dev/null || fail "the proxy does not match its configuration"
  echo "proxy_ready listen=$LISTEN upstream=$UPSTREAM latency_ms=$latency"
}

stop() {
  [ -f "$RUN/toxiproxy.pid" ] || return 0
  pid=$(cat "$RUN/toxiproxy.pid")
  kill -s TERM "$pid" 2>/dev/null
  tenths=0
  while kill -0 "$pid" 2>/dev/null; do
    [ "$tenths" -lt 300 ] || fail "toxiproxy did not stop"
    sleep 0.1
    tenths=$((tenths + 1))
  done
  rm -f "$RUN/toxiproxy.pid" "$MARK"
}

[ "$(id -u)" = 0 ] || fail "must run as root"
case ${1-} in
  start) start ;;
  check) check ;;
  set-latency) [ $# -eq 2 ] || fail "usage: rbw-proxy set-latency <ms>|default"; set_latency "$2" ;;
  latency) show_latency ;;
  stop) stop ;;
  *) echo "usage: rbw-proxy start|check|set-latency <ms>|default|latency|stop" >&2; exit 2 ;;
esac
