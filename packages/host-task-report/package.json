{
  "name": "@rbw/host-task-report",
  "version": "0.0.0",
  "private": true,
  "description": "Evaluator-side material for the task-report host: baseline identity, original-suite runner, the F3 verification check, its repetition protocols, the candidate catalogs, the local copy runners and the factory host adapter",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./adapter": "./adapter/index.ts"
  },
  "engines": {
    "node": ">=24.21 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "runner": "node src/local/cli.ts"
  },
  "dependencies": {
    "@rbw/factory-contract": "workspace:*",
    "@rbw/schema": "workspace:*",
    "diff": "9.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
