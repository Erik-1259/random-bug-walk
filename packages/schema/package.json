{
  "name": "@rbw/schema",
  "version": "0.0.0",
  "private": true,
  "description": "Shared record schema, canonical JSON v1, project policy and family registry",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=24.21 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "generate": "node scripts/generate.ts",
    "report": "node scripts/report.ts"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "canonicalize": "5.1.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
