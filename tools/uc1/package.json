{
  "name": "@rbw/uc1",
  "version": "0.0.0",
  "private": true,
  "description": "The UC1 paired comparison's run orchestrator: the pre-registered attempts in order, the spend guard, both grades and the run directory the analyzer and the publisher read",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=24.21 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "uc1": "node src/cli.ts"
  },
  "dependencies": {
    "@rbw/controller": "workspace:*",
    "@rbw/envelope": "workspace:*",
    "@rbw/local-runner": "workspace:*",
    "@rbw/schema": "workspace:*",
    "@rbw/solver": "workspace:*",
    "@rbw/solver-session": "workspace:*",
    "@rbw/spend": "workspace:*",
    "@rbw/writer": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
