{
  "name": "@rbw/local-runner",
  "version": "0.0.0",
  "private": true,
  "description": "Host-side runner for the first local sequence: kit check, observation and admission on Docker, as development evidence",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=24.21 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "runner": "node src/cli.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@rbw/admission": "workspace:*",
    "@rbw/projection": "workspace:*",
    "@rbw/schema": "workspace:*",
    "@rbw/search": "workspace:*",
    "@rbw/shapes": "workspace:*",
    "@rbw/spend": "workspace:*",
    "@rbw/umami-driver": "workspace:*",
    "@rbw/umami-fixture": "workspace:*",
    "@rbw/writer": "workspace:*",
    "axios": "1.20.0",
    "diff": "9.0.0",
    "tar-stream": "3.2.2"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
