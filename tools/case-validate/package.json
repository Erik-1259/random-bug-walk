{
  "name": "@rbw/case-validate",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone validation harness rbw-validate: verifies a bug case and its validator package, rebuilds the three copy states and runs them through a host adapter and a copy runner",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./registry": "./src/registry.ts",
    "./version": "./src/version.ts",
    "./docker": "./src/docker.ts"
  },
  "engines": {
    "node": ">=24.21 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "rbw-validate": "node src/cli.ts"
  },
  "dependencies": {
    "@rbw/case-package": "workspace:*",
    "@rbw/factory-contract": "workspace:*",
    "@rbw/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
