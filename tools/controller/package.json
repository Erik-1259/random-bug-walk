{
  "name": "@rbw/controller",
  "version": "0.0.0",
  "private": true,
  "description": "Trusted controller: runs one job of app copies end to end against the spend ledger, one copy at a time",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./judge": "./src/judge.ts",
    "./judge-web": "./src/judge-web.ts",
    "./judge-types": "./src/judge-types.ts"
  },
  "engines": {
    "node": ">=24.21 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:integration": "node test/integration/run.ts",
    "controller": "node src/cli.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@rbw/admission": "workspace:*",
    "@rbw/envelope": "workspace:*",
    "@rbw/local-runner": "workspace:*",
    "@rbw/publisher": "workspace:*",
    "@rbw/schema": "workspace:*",
    "@rbw/search": "workspace:*",
    "@rbw/spend": "workspace:*",
    "@rbw/umami-driver": "workspace:*",
    "@rbw/umami-fixture": "workspace:*",
    "@rbw/umami-fixture-rc1": "workspace:*",
    "@rbw/writer": "workspace:*",
    "@vercel/sandbox": "3.5.1",
    "pg": "8.23.1",
    "tar-stream": "3.2.2"
  },
  "devDependencies": {
    "@rbw/shapes": "workspace:*",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
