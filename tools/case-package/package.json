{
  "name": "@rbw/case-package",
  "version": "0.0.0",
  "private": true,
  "description": "Exporter for the two package parts of a bug case (rbw-bug-case/1 and rbw-validator/1): deterministic archives, pair binding, separation checks, final-validator assembly and a synthetic host",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./format": "./src/format.ts",
    "./assembly": "./src/assembly.ts",
    "./synthetic": "./src/synthetic.ts"
  },
  "engines": {
    "node": ">=24.21 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "case-package": "node src/cli.ts"
  },
  "dependencies": {
    "@rbw/factory-contract": "workspace:*",
    "@rbw/projection": "workspace:*",
    "@rbw/schema": "workspace:*",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
