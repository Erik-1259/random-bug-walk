{
  "name": "@rbw/release",
  "version": "0.0.0",
  "private": true,
  "description": "Release tooling: stage a terminal root for the publisher, build a checked release and its frozen judge job, and publish judge replays",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=24.21 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "release": "node src/cli.ts",
    "fixture": "node scripts/release-fixture.ts --out fixtures/release"
  },
  "dependencies": {
    "@rbw/admission": "workspace:*",
    "@rbw/controller": "workspace:*",
    "@rbw/envelope": "workspace:*",
    "@rbw/local-runner": "workspace:*",
    "@rbw/publisher": "workspace:*",
    "@rbw/schema": "workspace:*",
    "@rbw/umami-driver": "workspace:*",
    "@rbw/umami-fixture": "workspace:*",
    "@rbw/writer": "workspace:*",
    "tar-stream": "3.2.2"
  },
  "devDependencies": {
    "@rbw/shapes": "workspace:*",
    "@types/node": "24.19.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
